{
  "name": "deshi-basket",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Deshi Basket — a static South Asian grocery storefront on GitHub Pages",
  "scripts": {
    "dev": "npx @tailwindcss/cli -i ./src/input.css -o ./assets/css/main.css --watch",
    "build": "npx @tailwindcss/cli -i ./src/input.css -o ./assets/css/main.css --minify",
    "serve": "node scripts/serve.mjs 5173",
    "placeholders": "node scripts/placeholders.mjs",
    "check": "node scripts/check.mjs",
    "e2e": "node scripts/e2e.mjs"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@tailwindcss/cli": "^4.3.3",
    "puppeteer-core": "^25.11.0",
    "tailwindcss": "^4.3.3"
  }
}
